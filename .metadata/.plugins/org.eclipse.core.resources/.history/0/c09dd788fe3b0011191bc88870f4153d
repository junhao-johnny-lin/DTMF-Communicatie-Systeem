/*******************************************************************************
* Macros
*******************************************************************************/
#define FRAME_SIZE                  (1024)
#define SAMPLE_RATE_HZ              (8000u)
#define DECIMATION_RATE             (64u)
#define AUDIO_SYS_CLOCK_HZ_RX       (24576000u)

/* I2S TX */
#define MCLK_FREQ_HZ                4083000u
#define MCLK_DUTY_CYCLE             50.0f
#define AUDIO_SYS_CLOCK_HZ_TX       98000000u
#define MCLK_PIN                    P5_0
#define HFCLK1_CLK_DIVIDER          4u

#define PDM_DATA                    P10_5
#define PDM_CLK                     P10_4

#define AMPLITUDE_THRESHOLD         (20u)
#define GOERTZEL_MIN_ENERGY         (1000000.0f)
#define DOMINANCE_RATIO             (2.5f)

#define RESPONSE_HOLD_OFF_FRAMES    (12u)

/*******************************************************************************
* Function Prototypes
*******************************************************************************/
