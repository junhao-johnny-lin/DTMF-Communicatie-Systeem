* Global Variables
*******************************************************************************/
volatile bool pdm_pcm_flag = false;
volatile bool tx_busy = false;

cyhal_pdm_pcm_t pdm_pcm;
cyhal_clock_t   audio_clock;
cyhal_clock_t   pll_clock;

/* I2S TX objects */
cyhal_pwm_t mclk_pwm;
cyhal_i2s_t i2s;
cyhal_clock_t tx_audio_clock;
cyhal_clock_t tx_pll_clock;
cyhal_clock_t fll_clock;
cyhal_clock_t system_clock;

#ifdef USE_AK4954A
cyhal_i2c_t mi2c;
const cyhal_i2c_cfg_t mi2c_config = {
    .is_slave = false,
    .address = 0,
    .frequencyhal_hz = 400000
};
#endif

const cyhal_pdm_pcm_cfg_t pdm_pcm_cfg =
{
    .sample_rate     = SAMPLE_RATE_HZ,
    .decimation_rate = DECIMATION_RATE,
    .mode            = CYHAL_PDM_PCM_MODE_LEFT,
    .word_length     = 16,
    .left_gain       = 0,
    .right_gain      = 0,
};

const cyhal_i2s_pins_t i2s_pins = {
    .sck  = P5_1,
    .ws   = P5_2,
    .data = P5_3,
    .mclk = NC,
};

const cyhal_i2s_config_t i2s_config = {
    .is_tx_slave    = false,
    .is_rx_slave    = false,
    .mclk_hz        = 0,
    .channel_length = 32,
    .word_length    = 16,
    .sample_rate_hz = 16000,
};

/* DTMF tables */
static const float low_freqs[4]  = {697.0f, 770.0f, 852.0f, 941.0f};
static const float high_freqs[3] = {1209.0f, 1336.0f, 1477.0f};

static const char dtmf_map[4][3] =
{
    {'1', '2', '3'},
    {'4', '5', '6'},
    {'7', '8', '9'},
    {'*', '0', '#'}
};

/*******************************************************************************
* main
*******************************************************************************/
int main(void)
{
    cy_rslt_t result;
    int16_t audio_frame[FRAME_SIZE] = {0};

    char last_detected = '\0';
    uint32_t stable_count = 0;
    uint32_t holdoff_frames = 0;

    result = cybsp_init();
    if (result != CY_RSLT_SUCCESS)
    {
        CY_ASSERT(0);
    }

    __enable_irq();

    clock_init();

    cy_retarget_io_init(CYBSP_DEBUG_UART_TX,
                        CYBSP_DEBUG_UART_RX,
                        CY_RETARGET_IO_BAUDRATE);

    cyhal_gpio_init(CYBSP_USER_LED,
                    CYHAL_GPIO_DIR_OUTPUT,
                    CYHAL_GPIO_DRIVE_STRONG,
                    CYBSP_LED_STATE_OFF);

    /* ---------- PDM MIC INIT ---------- */
    result = cyhal_pdm_pcm_init(&pdm_pcm,
                                PDM_DATA,
                                PDM_CLK,
                                &audio_clock,
                                &pdm_pcm_cfg);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("PDM init failed\r\n");
        CY_ASSERT(0);
    }

    cyhal_pdm_pcm_register_callback(&pdm_pcm, pdm_pcm_isr_handler, NULL);
    cyhal_pdm_pcm_enable_event(&pdm_pcm,
                               CYHAL_PDM_PCM_ASYNC_COMPLETE,
                               CYHAL_ISR_PRIORITY_DEFAULT,
                               true);

    cyhal_pdm_pcm_start(&pdm_pcm);

    /* ---------- I2S TX INIT ---------- */
    cyhal_pwm_init(&mclk_pwm, MCLK_PIN, NULL);
    cyhal_pwm_set_duty_cycle(&mclk_pwm, MCLK_DUTY_CYCLE, MCLK_FREQ_HZ);
    cyhal_pwm_start(&mclk_pwm);

    cyhal_system_delay_ms(1);

    cyhal_i2s_init(&i2s, &i2s_pins, NULL, &i2s_config, &tx_audio_clock);
    cyhal_i2s_register_callback(&i2s, i2s_isr_handler, NULL);
    cyhal_i2s_enable_event(&i2s,
                           CYHAL_I2S_ASYNC_TX_COMPLETE,
                           CYHAL_ISR_PRIORITY_DEFAULT,
                           true);

#ifdef USE_AK4954A
    cyhal_i2c_init(&mi2c, CYBSP_I2C_SDA, CYBSP_I2C_SCL, NULL);
    cyhal_i2c_configure(&mi2c, &mi2c_config);

    result = mtb_ak4954a_init(&mi2c);
    if (result != 0)
    {
        NVIC_SystemReset();
    }

    mtb_ak4954a_activate();
    mtb_ak4954a_adjust_volume(AK4954A_HP_VOLUME_DEFAULT);
#endif

    result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("First read failed\r\n");
        CY_ASSERT(0);
    }

    printf("\x1b[2J\x1b[;H");
    printf("DTMF Receiver + Responder gestart\r\n");

    for (;;)
    {
        if (pdm_pcm_flag)
        {
            pdm_pcm_flag = false;

            if (holdoff_frames > 0)
            {
                holdoff_frames--;
            }

            char detected = detect_dtmf(audio_frame, FRAME_SIZE);

            if (detected != '\0')
            {
                if (detected == last_detected)
                {
                    stable_count++;
                }
                else
                {
                    last_detected = detected;
                    stable_count = 1;
                }

                if (stable_count >= 2)
                {
                    cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_ON);
                    printf("DTMF detected: %c\r\n", detected);

                    if ((!tx_busy) && (holdoff_frames == 0))
                    {
                        char reply = next_digit(detected);
                        printf("Sending back: %c\r\n", reply);

                        generate_dtmf_digit(reply);

                        cyhal_i2s_start_tx(&i2s);
                        tx_busy = true;
                        cyhal_i2s_write_async(&i2s, audio_buffer, NUM_SAMPLES * 2);

                        holdoff_frames = RESPONSE_HOLD_OFF_FRAMES;
                    }
                }
            }
            else
            {
                last_detected = '\0';
                stable_count = 0;
                cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_OFF);
            }

            result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
            if (result != CY_RSLT_SUCCESS)
            {
                printf("Read failed\r\n");
            }
        }

        cyhal_syspm_sleep();
    }
}

/*******************************************************************************
* detect_dtmf
*******************************************************************************/
char detect_dtmf(int16_t *audio_frame, uint32_t frame_size)
{
    float low_energy[4];
    float high_energy[3];

    uint32_t abs_sum = 0;
    uint32_t avg_amplitude = 0;

    for (uint32_t i = 0; i < frame_size; i++)
    {
        abs_sum += abs(audio_frame[i]);
    }

    avg_amplitude = abs_sum / frame_size;

    if (avg_amplitude < AMPLITUDE_THRESHOLD)
    {
        return '\0';
    }

    for (int i = 0; i < 4; i++)
    {
        low_energy[i] = goertzel(audio_frame, (int)frame_size, low_freqs[i], (float)SAMPLE_RATE_HZ);
    }

    for (int i = 0; i < 3; i++)
    {
        high_energy[i] = goertzel(audio_frame, (int)frame_size, high_freqs[i], (float)SAMPLE_RATE_HZ);
    }

    int low_index = 0;
    int high_index = 0;

    for (int i = 1; i < 4; i++)
    {
        if (low_energy[i] > low_energy[low_index])
        {
            low_index = i;
        }
    }

    for (int i = 1; i < 3; i++)
    {
        if (high_energy[i] > high_energy[high_index])
        {
            high_index = i;
        }
    }

    float low_max = low_energy[low_index];
    float high_max = high_energy[high_index];

    float low_second = 0.0f;
    float high_second = 0.0f;

    for (int i = 0; i < 4; i++)
    {
        if (i != low_index && low_energy[i] > low_second)
        {
            low_second = low_energy[i];
        }
    }

    for (int i = 0; i < 3; i++)
    {
        if (i != high_index && high_energy[i] > high_second)
        {
            high_second = high_energy[i];
        }
    }

    if (low_max < GOERTZEL_MIN_ENERGY || high_max < GOERTZEL_MIN_ENERGY)
    {
        return '\0';
    }

    if ((low_second > 0.0f && (low_max / low_second) < DOMINANCE_RATIO) ||
        (high_second > 0.0f && (high_max / high_second) < DOMINANCE_RATIO))
    {
        return '\0';
    }

    return dtmf_map[low_index][high_index];
}

/*******************************************************************************
* next_digit
*******************************************************************************/
char next_digit(char d)
{
    switch (d)
    {
        case '1': return '2';
        case '2': return '3';
        case '3': return '4';
        case '4': return '5';
        case '5': return '6';
        case '6': return '7';
        case '7': return '8';
        case '8': return '9';
        case '9': return '1';
        case '0': return '1';
        default:  return '5';
    }
}

/*******************************************************************************
* ISRs
*******************************************************************************/
void pdm_pcm_isr_handler(void *arg, cyhal_pdm_pcm_event_t event)
{
    (void)arg;
    (void)event;
    pdm_pcm_flag = true;
}

void i2s_isr_handler(void *arg, cyhal_i2s_event_t event)
{
    (void)arg;
    (void)event;

    cyhal_i2s_stop_tx(&i2s);
    tx_busy = false;
}

/*******************************************************************************
* clock_init
*******************************************************************************/
void clock_init(void)
{
    /* PLL for RX audio clock */
    cyhal_clock_reserve(&pll_clock, &CYHAL_CLOCK_PLL[0]);
    cyhal_clock_set_frequency(&pll_clock, AUDIO_SYS_CLOCK_HZ_RX, NULL);
    cyhal_clock_set_enabled(&pll_clock, true, true);

    cyhal_clock_reserve(&audio_clock, &CYHAL_CLOCK_HF[1]);
    cyhal_clock_set_source(&audio_clock, &pll_clock);
    cyhal_clock_set_enabled(&audio_clock, true, true);

    /* Separate setup for TX side, same style as I2S template */
    cyhal_clock_reserve(&tx_pll_clock, &CYHAL_CLOCK_PLL[1]);
    cyhal_clock_set_frequency(&tx_pll_clock, AUDIO_SYS_CLOCK_HZ_TX, NULL);
    cyhal_clock_set_enabled(&tx_pll_clock, true, true);

    cyhal_clock_reserve(&tx_audio_clock, &CYHAL_CLOCK_HF[2]);
    cyhal_clock_set_source(&tx_audio_clock, &tx_pll_clock);
    cyhal_clock_set_divider(&tx_audio_clock, HFCLK1_CLK_DIVIDER);
    cyhal_clock_set_enabled(&tx_audio_clock, true, true);

    cyhal_clock_reserve(&system_clock, &CYHAL_CLOCK_HF[0]);
    cyhal_clock_set_source(&system_clock, &tx_pll_clock);

    cyhal_clock_reserve(&fll_clock, &CYHAL_CLOCK_FLL);
    cyhal_clock_set_enabled(&fll_clock, false, true);
}