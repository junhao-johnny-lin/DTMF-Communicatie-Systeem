/******************************************************************************
* File Name:   main.c
*
* Description: DTMF receiver using PDM microphone on PSoC6 Audio Shield.
*              Detects valid DTMF tones and turns LED on when detected.
******************************************************************************/

#include "cyhal.h"
#include "cybsp.h"
#include "cy_retarget_io.h"

#include <stdlib.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>

#include "goertzel.h"

/*******************************************************************************
* Macros
*******************************************************************************/
#define FRAME_SIZE                  (1024)
#define SAMPLE_RATE_HZ              (8000u)
#define DECIMATION_RATE             (64u)
#define AUDIO_SYS_CLOCK_HZ          (24576000u)

#define PDM_DATA                    P10_5
#define PDM_CLK                     P10_4

/* Extra checks against random noise */
#define AMPLITUDE_THRESHOLD         (20u)

/* Goertzel thresholds: tune these experimentally if needed */
#define GOERTZEL_MIN_ENERGY         (1000000.0f)
#define DOMINANCE_RATIO             (2.5f)

/*******************************************************************************
* Function Prototypes
*******************************************************************************/
void pdm_pcm_isr_handler(void *arg, cyhal_pdm_pcm_event_t event);
void clock_init(void);
char detect_dtmf(int16_t *audio_frame, uint32_t frame_size);

/*******************************************************************************
* Global Variables
*******************************************************************************/
volatile bool pdm_pcm_flag = false;

cyhal_pdm_pcm_t pdm_pcm;
cyhal_clock_t   audio_clock;
cyhal_clock_t   pll_clock;

/* Single mic channel is easier for detection */
const cyhal_pdm_pcm_cfg_t pdm_pcm_cfg =
{
    .sample_rate     = SAMPLE_RATE_HZ,
    .decimation_rate = DECIMATION_RATE,
    .mode            = CYHAL_PDM_PCM_MODE_LEFT,
    .word_length     = 16,
    .left_gain       = 0,
    .right_gain      = 0,
};

/* DTMF frequency tables */
static const float low_freqs[4]  = {697.0f, 770.0f, 852.0f, 941.0f};
static const float high_freqs[3] = {1209.0f, 1336.0f, 1477.0f};

static const char dtmf_map[4][3] =
{
    {'1', '2', '3'},
    {'4', '5', '6'},
    {'7', '8', '9'},
    {'*', '0', '#'}
};

/*******************************************************************************
* Function Name: main
*******************************************************************************/
int main(void)
{
    cy_rslt_t result;
    int16_t audio_frame[FRAME_SIZE] = {0};

    char last_detected = '\0';
    uint32_t stable_count = 0;

    result = cybsp_init();
    if (result != CY_RSLT_SUCCESS)
    {
        CY_ASSERT(0);
    }

    __enable_irq();

    clock_init();

    cy_retarget_io_init(CYBSP_DEBUG_UART_TX,
                        CYBSP_DEBUG_UART_RX,
                        CY_RETARGET_IO_BAUDRATE);

    cyhal_gpio_init(CYBSP_USER_LED,
                    CYHAL_GPIO_DIR_OUTPUT,
                    CYHAL_GPIO_DRIVE_STRONG,
                    CYBSP_LED_STATE_OFF);

    result = cyhal_pdm_pcm_init(&pdm_pcm,
                                PDM_DATA,
                                PDM_CLK,
                                &audio_clock,
                                &pdm_pcm_cfg);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("PDM init failed\r\n");
        CY_ASSERT(0);
    }

    cyhal_pdm_pcm_register_callback(&pdm_pcm, pdm_pcm_isr_handler, NULL);
    cyhal_pdm_pcm_enable_event(&pdm_pcm,
                               CYHAL_PDM_PCM_ASYNC_COMPLETE,
                               CYHAL_ISR_PRIORITY_DEFAULT,
                               true);

    cyhal_pdm_pcm_start(&pdm_pcm);

    result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("First read failed\r\n");
        CY_ASSERT(0);
    }

    printf("\x1b[2J\x1b[;H");
    printf("DTMF Receiver gestart\r\n");

    for (;;)
    {
        if (pdm_pcm_flag)
        {
            pdm_pcm_flag = false;

            char detected = detect_dtmf(audio_frame, FRAME_SIZE);

            if (detected != '\0')
            {
                if (detected == last_detected)
                {
                    stable_count++;
                }
                else
                {
                    last_detected = detected;
                    stable_count = 1;
                }

                /* Require 2 consecutive detections for stability */
                if (stable_count >= 2)
                {
                    cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_ON);
                    printf("DTMF detected: %c\r\n", detected);
                }
            }
            else
            {
                last_detected = '\0';
                stable_count = 0;
                cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_OFF);
            }

            result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
            if (result != CY_RSLT_SUCCESS)
            {
                printf("Read failed\r\n");
            }
        }

        cyhal_syspm_sleep();
    }
}

/*******************************************************************************
* Function Name: detect_dtmf
*******************************************************************************/
char detect_dtmf(int16_t *audio_frame, uint32_t frame_size)
{
    float low_energy[4];
    float high_energy[3];

    uint32_t abs_sum = 0;
    uint32_t avg_amplitude = 0;

    for (uint32_t i = 0; i < frame_size; i++)
    {
        abs_sum += abs(audio_frame[i]);
    }

    avg_amplitude = abs_sum / frame_size;

    if (avg_amplitude < AMPLITUDE_THRESHOLD)
    {
        return '\0';
    }

    for (int i = 0; i < 4; i++)
    {
        low_energy[i] = goertzel(audio_frame, (int)frame_size, low_freqs[i], (float)SAMPLE_RATE_HZ);
    }

    for (int i = 0; i < 3; i++)
    {
        high_energy[i] = goertzel(audio_frame, (int)frame_size, high_freqs[i], (float)SAMPLE_RATE_HZ);
    }

    int low_index = 0;
    int high_index = 0;

    for (int i = 1; i < 4; i++)
    {
        if (low_energy[i] > low_energy[low_index])
        {
            low_index = i;
        }
    }

    for (int i = 1; i < 3; i++)
    {
        if (high_energy[i] > high_energy[high_index])
        {
            high_index = i;
        }
    }

    float low_max = low_energy[low_index];
    float high_max = high_energy[high_index];

    float low_second = 0.0f;
    float high_second = 0.0f;

    for (int i = 0; i < 4; i++)
    {
        if (i != low_index && low_energy[i] > low_second)
        {
            low_second = low_energy[i];
        }
    }

    for (int i = 0; i < 3; i++)
    {
        if (i != high_index && high_energy[i] > high_second)
        {
            high_second = high_energy[i];
        }
    }

    if (low_max < GOERTZEL_MIN_ENERGY || high_max < GOERTZEL_MIN_ENERGY)
    {
        return '\0';
    }

    if ((low_second > 0.0f && (low_max / low_second) < DOMINANCE_RATIO) ||
        (high_second > 0.0f && (high_max / high_second) < DOMINANCE_RATIO))
    {
        return '\0';
    }

    return dtmf_map[low_index][high_index];
}

/*******************************************************************************
* Function Name: pdm_pcm_isr_handler
*******************************************************************************/
void pdm_pcm_isr_handler(void *arg, cyhal_pdm_pcm_event_t event)
{
    (void)arg;
    (void)event;

    pdm_pcm_flag = true;
}

/*******************************************************************************
* Function Name: clock_init
*******************************************************************************/
void clock_init(void)
{
    cyhal_clock_reserve(&pll_clock, &CYHAL_CLOCK_PLL[0]);
    cyhal_clock_set_frequency(&pll_clock, AUDIO_SYS_CLOCK_HZ, NULL);
    cyhal_clock_set_enabled(&pll_clock, true, true);

    cyhal_clock_reserve(&audio_clock, &CYHAL_CLOCK_HF[1]);
    cyhal_clock_set_source(&audio_clock, &pll_clock);
    cyhal_clock_set_enabled(&audio_clock, true, true);
}