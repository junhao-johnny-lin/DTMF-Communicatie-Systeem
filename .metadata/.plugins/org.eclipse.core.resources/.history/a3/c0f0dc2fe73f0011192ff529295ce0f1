#include "cyhal.h"
#include "cybsp.h"

#include "cy8ckit_028_tft.h"
#include "GUI.h"

#include "dtmf.h"

#ifdef USE_AK4954A
#include "mtb_ak4954a.h"
#endif

#define MCLK_FREQ_HZ        4083000u
#define MCLK_DUTY_CYCLE     50.0f
#define AUDIO_SYS_CLOCK_HZ  98000000u
#define MCLK_PIN            P5_0
#define DEBOUNCE_DELAY_MS   10u
#define HFCLK1_CLK_DIVIDER  4u

#define BLUE P11_1

void i2s_isr_handler(void *arg, cyhal_i2s_event_t event);
void clock_init(void);
void tft_show_ready(void);
void tft_show_sending(void);

/* HAL objects */
cyhal_pwm_t mclk_pwm;

#ifdef USE_AK4954A
cyhal_i2c_t mi2c;
#endif

cyhal_i2s_t i2s;
cyhal_clock_t audio_clock;
cyhal_clock_t pll_clock;
cyhal_clock_t fll_clock;
cyhal_clock_t system_clock;

#ifdef USE_AK4954A
const cyhal_i2c_cfg_t mi2c_config = {
    .is_slave = false,
    .address = 0,
    .frequencyhal_hz = 400000
};
#endif

const cyhal_i2s_pins_t i2s_pins = {
    .sck  = P5_1,
    .ws   = P5_2,
    .data = P5_3,
    .mclk = NC,
};

const cyhal_i2s_config_t i2s_config = {
    .is_tx_slave    = false,
    .is_rx_slave    = false,
    .mclk_hz        = 0,
    .channel_length = 32,
    .word_length    = 16,
    .sample_rate_hz = 16000,
};

int main(void)
{
    cy_rslt_t result;

    result = cybsp_init();
    if (result != CY_RSLT_SUCCESS)
    {
        CY_ASSERT(0);
    }

    __enable_irq();

    /* TFT init */
    cy8ckit_028_tft_init(NULL, NULL, NULL, NULL);
    GUI_Init();

    GUI_SetFont(&GUI_Font16_ASCII);
    GUI_SetBkColor(GUI_BLACK);
    GUI_SetColor(GUI_WHITE);
    GUI_Clear();

    tft_show_ready();

    clock_init();

    /* LED init */
    cyhal_gpio_init(BLUE,
                    CYHAL_GPIO_DIR_OUTPUT,
                    CYHAL_GPIO_DRIVE_STRONG,
                    CYBSP_LED_STATE_OFF);

    /* Button init */
    cyhal_gpio_init(CYBSP_USER_BTN,
                    CYHAL_GPIO_DIR_INPUT,
                    CYHAL_GPIO_DRIVE_PULLUP,
                    CYBSP_BTN_OFF);

    cyhal_gpio_enable_event(CYBSP_USER_BTN,
                            CYHAL_GPIO_IRQ_FALL,
                            CYHAL_ISR_PRIORITY_DEFAULT,
                            true);

    /* MCLK voor audio codec */
    cyhal_pwm_init(&mclk_pwm, MCLK_PIN, NULL);
    cyhal_pwm_set_duty_cycle(&mclk_pwm, MCLK_DUTY_CYCLE, MCLK_FREQ_HZ);
    cyhal_pwm_start(&mclk_pwm);

    cyhal_system_delay_ms(1);

    /* I2S init */
    cyhal_i2s_init(&i2s, &i2s_pins, NULL, &i2s_config, &audio_clock);

    cyhal_i2s_register_callback(&i2s, i2s_isr_handler, NULL);

    cyhal_i2s_enable_event(&i2s,
                           CYHAL_I2S_ASYNC_TX_COMPLETE,
                           CYHAL_ISR_PRIORITY_DEFAULT,
                           true);

#ifdef USE_AK4954A
    cyhal_i2c_init(&mi2c,
                   CYBSP_I2C_SDA,
                   CYBSP_I2C_SCL,
                   NULL);

    cyhal_i2c_configure(&mi2c, &mi2c_config);

    result = mtb_ak4954a_init(&mi2c);
    if (result != 0)
    {
        NVIC_SystemReset();
    }

    mtb_ak4954a_activate();
    mtb_ak4954a_adjust_volume(AK4954A_HP_VOLUME_DEFAULT);
#endif

    for (;;)
    {
        cyhal_syspm_sleep();

        if (cyhal_gpio_read(CYBSP_USER_BTN) == CYBSP_BTN_PRESSED)
        {
            if (!cyhal_i2s_is_write_pending(&i2s))
            {
                tft_show_sending();

                cyhal_i2s_start_tx(&i2s);

                /* DTMF toon: toets 5 = 770 Hz + 1336 Hz */
                generate_dtmf(770.0f, 1336.0f);

                cyhal_i2s_write_async(&i2s,
                                      audio_buffer,
                                      NUM_SAMPLES * 2);

                cyhal_gpio_write(BLUE, CYBSP_LED_STATE_ON);
            }

            cyhal_system_delay_ms(DEBOUNCE_DELAY_MS);
        }
    }
}

void i2s_isr_handler(void *arg, cyhal_i2s_event_t event)
{
    (void)arg;
    (void)event;

    cyhal_i2s_stop_tx(&i2s);
    cyhal_gpio_write(BLUE, CYBSP_LED_STATE_OFF);

    tft_show_ready();
}

void tft_show_ready(void)
{
    GUI_Clear();
    GUI_SetBkColor(GUI_BLACK);

    GUI_SetColor(GUI_WHITE);
    GUI_DispStringAt("DTMF Zender", 10, 10);

    GUI_SetColor(GUI_GREEN);
    GUI_DispStringAt("Status: Ready", 10, 40);

    GUI_SetColor(GUI_WHITE);
    GUI_DispStringAt("Button = send 5", 10, 70);
}

void tft_show_sending(void)
{
    GUI_Clear();
    GUI_SetBkColor(GUI_BLACK);

    GUI_SetColor(GUI_WHITE);
    GUI_DispStringAt("DTMF Zender", 10, 10);

    GUI_SetColor(GUI_YELLOW);
    GUI_DispStringAt("Sending DTMF: 5", 10, 40);

    GUI_SetColor(GUI_WHITE);
    GUI_DispStringAt("770 Hz + 1336 Hz", 10, 70);
}

void clock_init(void)
{
    cyhal_clock_reserve(&pll_clock, &CYHAL_CLOCK_PLL[0]);
    cyhal_clock_set_frequency(&pll_clock, AUDIO_SYS_CLOCK_HZ, NULL);
    cyhal_clock_set_enabled(&pll_clock, true, true);

    cyhal_clock_reserve(&audio_clock, &CYHAL_CLOCK_HF[1]);
    cyhal_clock_set_source(&audio_clock, &pll_clock);

    cyhal_clock_set_divider(&audio_clock, HFCLK1_CLK_DIVIDER);
    cyhal_clock_set_enabled(&audio_clock, true, true);

    cyhal_clock_reserve(&system_clock, &CYHAL_CLOCK_HF[0]);
    cyhal_clock_set_source(&system_clock, &pll_clock);

    cyhal_clock_reserve(&fll_clock, &CYHAL_CLOCK_FLL);
    cyhal_clock_set_enabled(&fll_clock, false, true);
}