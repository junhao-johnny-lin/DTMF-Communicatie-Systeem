#include "cyhal.h"
#include "cybsp.h"
#include "cy_retarget_io.h"

#include <stdlib.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>

/*******************************************************************************
* Macros
********************************************************************************/
#define FRAME_SIZE                  (1024)
#define SAMPLE_RATE_HZ              8000u
#define DECIMATION_RATE             64u
#define AUDIO_SYS_CLOCK_HZ          24576000u

#define PDM_DATA                    P10_5
#define PDM_CLK                     P10_4

/* Detectie-drempels */
#define AMPLITUDE_THRESHOLD         25
#define ZERO_CROSS_MIN              80
#define ZERO_CROSS_MAX              500

/*******************************************************************************
* Function Prototypes
********************************************************************************/
void pdm_pcm_isr_handler(void *arg, cyhal_pdm_pcm_event_t event);
void clock_init(void);

/*******************************************************************************
* Global Variables
********************************************************************************/
volatile bool pdm_pcm_flag = false;

cyhal_pdm_pcm_t pdm_pcm;
cyhal_clock_t   audio_clock;
cyhal_clock_t   pll_clock;

/* Gebruik 1 kanaal. Voor ingebouwde mic is LEFT meestal het handigst */
const cyhal_pdm_pcm_cfg_t pdm_pcm_cfg =
{
    .sample_rate     = SAMPLE_RATE_HZ,
    .decimation_rate = DECIMATION_RATE,
    .mode            = CYHAL_PDM_PCM_MODE_LEFT,
    .word_length     = 16,
    .left_gain       = 0,
    .right_gain      = 0,
};

/*******************************************************************************
* Function Name: main
********************************************************************************/
int main(void)
{
    cy_rslt_t result;
    int16_t audio_frame[FRAME_SIZE] = {0};

    result = cybsp_init();
    if (result != CY_RSLT_SUCCESS)
    {
        CY_ASSERT(0);
    }

    __enable_irq();

    clock_init();

    cy_retarget_io_init(CYBSP_DEBUG_UART_TX,
                        CYBSP_DEBUG_UART_RX,
                        CY_RETARGET_IO_BAUDRATE);

    cyhal_gpio_init(CYBSP_USER_LED,
                    CYHAL_GPIO_DIR_OUTPUT,
                    CYHAL_GPIO_DRIVE_STRONG,
                    CYBSP_LED_STATE_OFF);

    result = cyhal_pdm_pcm_init(&pdm_pcm,
                                PDM_DATA,
                                PDM_CLK,
                                &audio_clock,
                                &pdm_pcm_cfg);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("PDM init failed\r\n");
        CY_ASSERT(0);
    }

    cyhal_pdm_pcm_register_callback(&pdm_pcm, pdm_pcm_isr_handler, NULL);
    cyhal_pdm_pcm_enable_event(&pdm_pcm,
                               CYHAL_PDM_PCM_ASYNC_COMPLETE,
                               CYHAL_ISR_PRIORITY_DEFAULT,
                               true);

    cyhal_pdm_pcm_start(&pdm_pcm);

    /* Eerste frame starten */
    result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
    if (result != CY_RSLT_SUCCESS)
    {
        printf("First read failed\r\n");
        CY_ASSERT(0);
    }

    printf("\x1b[2J\x1b[;H");
    printf("PDM toon detector gestart\r\n");

    for (;;)
    {
        if (pdm_pcm_flag)
        {
            pdm_pcm_flag = false;

            uint32_t abs_sum = 0;
            uint32_t zero_crossings = 0;

            for (uint32_t i = 0; i < FRAME_SIZE; i++)
            {
                abs_sum += abs(audio_frame[i]);
            }

            for (uint32_t i = 1; i < FRAME_SIZE; i++)
            {
                if ((audio_frame[i - 1] > 0 && audio_frame[i] < 0) ||
                    (audio_frame[i - 1] < 0 && audio_frame[i] > 0))
                {
                    zero_crossings++;
                }
            }

            uint32_t avg_amplitude = abs_sum / FRAME_SIZE;

            bool tone_detected = false;

            if ((avg_amplitude > AMPLITUDE_THRESHOLD) &&
                (zero_crossings > ZERO_CROSS_MIN) &&
                (zero_crossings < ZERO_CROSS_MAX))
            {
                tone_detected = true;
            }

            if (tone_detected)
            {
                cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_ON);
                printf("TOON GEDETECTEERD | amp=%lu | zc=%lu\r\n",
                       (unsigned long)avg_amplitude,
                       (unsigned long)zero_crossings);
            }
            else
            {
                cyhal_gpio_write(CYBSP_USER_LED, CYBSP_LED_STATE_OFF);
            }

            result = cyhal_pdm_pcm_read_async(&pdm_pcm, audio_frame, FRAME_SIZE);
            if (result != CY_RSLT_SUCCESS)
            {
                printf("Read failed\r\n");
            }
        }

        cyhal_syspm_sleep();
    }
}

/*******************************************************************************
* Function Name: pdm_pcm_isr_handler
********************************************************************************/
void pdm_pcm_isr_handler(void *arg, cyhal_pdm_pcm_event_t event)
{
    (void)arg;
    (void)event;

    pdm_pcm_flag = true;
}

/*******************************************************************************
* Function Name: clock_init
********************************************************************************/
void clock_init(void)
{
    cyhal_clock_reserve(&pll_clock, &CYHAL_CLOCK_PLL[0]);
    cyhal_clock_set_frequency(&pll_clock, AUDIO_SYS_CLOCK_HZ, NULL);
    cyhal_clock_set_enabled(&pll_clock, true, true);

    cyhal_clock_reserve(&audio_clock, &CYHAL_CLOCK_HF[1]);
    cyhal_clock_set_source(&audio_clock, &pll_clock);
    cyhal_clock_set_enabled(&audio_clock, true, true);
}